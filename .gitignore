*.o
*.a

# Locally-built helper binaries the bootstrap scripts drop next to
# themselves (teepin-hostprobe has no extension on macOS/Linux, so *.exe
# above doesn't catch it; teepin-agent-linux-* is bootstrap-windows.ps1/
# bootstrap-macos.sh's cross-compiled agent binary passed to install.sh
# via --binary).
/deploy/agent/teepin-hostprobe
/deploy/agent/teepin-agent-linux-*

